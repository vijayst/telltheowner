# Paddle Billing. Do not default these in code.
# sandbox | production
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token. Sandbox tokens start with test_. Safe to expose in the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_
# Pro price IDs from the Paddle catalog (pri_...). Only the monthly price is shown.
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_
# Optional. Yearly billing is not offered on the pricing page.
# NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_

# Server-only API key. Never prefix with NEXT_PUBLIC_ and never import it from client components.
# PADDLE_API_KEY=
